# ============================================================
# 「宇宙是旷野」环境变量模板
# 复制为 .env 后填入真实值：cp .env.example .env
# 前端无需任何 key；以下仅后端需要
# ============================================================

# AI 问答（阿里云百炼）——唯一硬阻塞,不填则 /api/ai/* 全部 404
# 申请地址：https://bailian.console.aliyun.com/  -> API-KEY 管理
DASHSCOPE_API_KEY=

# LangSmith 追踪（可选）。不填则追踪静默降级,不影响主业务
# 申请地址：https://smith.langchain.com  -> Settings -> API keys
LANGSMITH_API_KEY=
# 追踪写入的项目名（LangSmith 侧叫 Project）
LANGSMITH_PROJECT=wilderness

# MySQL 应用账号密码（docker-compose 默认值,一般无需改）
MYSQL_PASSWORD=wilderness
