# ============================================================
# 「宇宙是旷野」环境变量模板
# 复制为 .env 后填入真实值：cp .env.example .env
# 前端无需任何 key；以下仅后端需要
# ============================================================

# AI 问答（阿里云百炼）——唯一硬阻塞,不填则 /api/ai/* 全部 404
# 申请地址：https://bailian.console.aliyun.com/  -> API-KEY 管理
DASHSCOPE_API_KEY=

# LangSmith 追踪（可选）。不填则追踪静默降级,不影响主业务
# 申请地址：https://smith.langchain.com  -> Settings -> API keys
LANGSMITH_API_KEY=
# 追踪写入的项目名（LangSmith 侧叫 Project）
LANGSMITH_PROJECT=wilderness

# MySQL 应用账号密码（docker-compose 默认值,一般无需改）
MYSQL_PASSWORD=wilderness

# ============================================================
# 邮箱验证码 SMTP（注册/登录的验证码邮件）
# QQ 邮箱: smtp.qq.com:465（需在 QQ 邮箱设置里开启 SMTP 并生成「授权码」作为密码）
# 163 邮箱: smtp.163.com:465（设置里开启 SMTP 获取授权码）
# 谷歌:    smtp.gmail.com:465（需应用专用密码）
# SMTP_FROM 一般与 SMTP_USERNAME 相同
# ============================================================
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# 天体生成 Agent 的文生图升级通道（可选）
# 在百炼开通「通义万相」后，填入 API Key 即让生成的天体图片升级为真实 AI 图；
# 不填则使用前端 SVG 程序化渲染（零依赖兜底，不影响功能）
# DASHSCOPE_IMAGE_API_KEY=
# DASHSCOPE_IMAGE_MODEL=wanx2.1-t2i-turbo

# 登录会话有效期（秒）。改这里即可调整登录时长，改完重启后端生效
AUTH_SESSION_TTL=604800
# HTTPS 部署时开启 Cookie Secure
# AUTH_COOKIE_SECURE=true
# 开发期把验证码打印到后端日志（无需真收邮件即可测试），正式环境勿开
# AUTH_DEV_CODE_LOG=true
