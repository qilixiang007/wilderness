# ============================================================
# 「宇宙是旷野」生产环境变量模板
#
# 用法（在服务器仓库根目录执行）：
#   cp deploy/env.prod.example .env
#   vim .env            # 逐个填真实值
#
# .env 已被 .gitignore 忽略，绝不会提交进仓库。改完需重启后端才生效：
#   docker compose -f docker-compose.prod.yml up -d
# ============================================================

# ========== 数据库凭据（务必改，别用默认/弱口令） ==========
# 应用账号（compose 里已固定用户名为 wilderness，密码取自这里）
MYSQL_PASSWORD=换成-强随机密码-至少16位
# MySQL root 密码（健康检查与手动运维用）
MYSQL_ROOT_PASSWORD=换成-另一个-强随机密码

# ========== AI（阿里云百炼）——唯一硬阻塞，不填则 /api/ai/* 全 404 ==========
# 申请：https://bailian.console.aliyun.com/ -> API-KEY 管理
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# 天体生成 Agent 的文生图升级通道（可选）。在百炼开通「通义万相」后填入，
# 生成的天体会变成真实 AI 图；不填则用前端 SVG 程序化渲染兜底。
# DASHSCOPE_IMAGE_API_KEY=
# DASHSCOPE_IMAGE_MODEL=wanx2.1-t2i-turbo

# LangSmith 追踪（可选，不填则静默降级）
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=wilderness

# ========== 邮箱验证码 SMTP（注册/登录验证码必填，否则发码接口 503） ==========
# QQ 邮箱：smtp.qq.com:465，需在邮箱设置开启 SMTP 并生成「授权码」当密码
# 163：smtp.163.com:465；谷歌：smtp.gmail.com:465（需应用专用密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=你的邮箱@qq.com
SMTP_PASSWORD=你的SMTP授权码
SMTP_FROM=你的邮箱@qq.com

# ========== 会话与 HTTPS ==========
# 登录有效期（秒），默认 7 天
AUTH_SESSION_TTL=604800
# 证书就绪、开启 HTTPS 后，把下面改成 true 再重启，登录 Cookie 才走 Secure
AUTH_COOKIE_SECURE=false

# ========== 可观测（Grafana 登录，务必改） ==========
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=换成-强密码

# ========== 可选调优 ==========
# Elasticsearch JVM 堆。机器内存紧张(4G)保持默认 512m；8G 及以上可提到 1g
# ES_JAVA_OPTS=-Xms1g -Xmx1g
